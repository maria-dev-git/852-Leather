            "accordion_row_PUXkJd": {
              "type": "_accordion-row",
              "name": "t:names.accordion_row",
              "settings": {
                "heading": "There are a lot of different colors, is your leather real?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_frwp9E": {
                  "type": "text",
                  "name": "t:names.text",
                  "settings": {
                    "text": "<p>Many of 852's leathers are small batch sourced, with colors that cannot be found in big brand stores.</p>",
                    "width": "100%",
                    "max_width": "none",
                    "alignment": "left",
                    "type_preset": "rte",
