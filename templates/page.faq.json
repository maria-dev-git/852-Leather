            },
            "accordion_row_H4wzfn": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Is the lead time really 4-8 weeks?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_qQwmtr": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Yes. &nbsp;852 bags are fully customizable by you, the customer.&nbsp;Therefore, they are not sitting on a shelf with a barcode in a port in some seaside warehouse.&nbsp;</p><p>Each bag is made by hand by me alone. The leather is hand selected, rigorously inspected, then cut, sewn, and built by hand to your specific requirements and hardware selection. &nbsp;&nbsp;</p>",
                    "width": "100%",
                    "max_width": "none",
                    "alignment": "left",
